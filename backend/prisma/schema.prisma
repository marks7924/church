datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  MEMBER
  SECRETARY
  TRIP_MANAGER
  PRIEST
  BISHOP
  CHURCH_ADMIN
  SUPER_ADMIN
  DEVELOPER
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConfessionStatus {
  ACTIVE
  TRAVELING
  INACTIVE
}

enum SocialStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  role             Role              @default(MEMBER)
  fullName         String
  phone            String?
  nationalId       String?           @unique
  language         String            @default("ar") // "ar" or "en"
  isVerified       Boolean           @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  refreshToken     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  familyProfile        FamilyHead?
  priestProfile        PriestProfile?
  appointments         Appointment[]             @relation("MemberAppointments")
  newsPosts            News[]                    @relation("UserNews")
  adminAiConversations AiAdminConversation[]     @relation("UserAdminAiConversations")
  receivedEmails       EmailMessage[]
  eventInvitations     EventInvitation[]
  eventApplications    EventApplication[]
  bibleProgress        BibleReadingProgress[]
  biblePosition        BibleLastPosition?
  bibleFavorites       BibleFavorite[]
  bibleJournals        BibleJournalEntry[]
  biblePlanProgress    BibleUserPlanProgress[]
  fySubmissions        FyMemberQuestionSubmission[]
}

model PriestProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  nameAr               String
  nameEn               String
  titleAr              String        // e.g., "أبونا", "سيدنا"
  titleEn              String        // e.g., "Father", "Bishop"
  maxBookingsPerDay    Int           @default(5)
  confessionDuration   Int           @default(15)
  bufferMinutes        Int           @default(5)
  avatarUrl            String?
  confessionStatus     ConfessionStatus @default(ACTIVE)
  confessionStatusNote String?       // Custom note like "مسافر خارج مصر"
  noFixedSchedule      Boolean       @default(false) // true = no preset slots
  // JSON field to store weekly availability and specific dates:
  // e.g., { "recurring": { "Sunday": [{"start": "09:00", "end": "10:00"}] }, "specific": { "2026-07-23": [{"start": "18:00", "end": "20:00"}] } }
  availabilityJson     String        @default("{}")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  appointments         Appointment[] @relation("PriestAppointments")
}

model Appointment {
  id             String            @id @default(uuid())
  memberId       String
  member         User              @relation("MemberAppointments", fields: [memberId], references: [id], onDelete: Cascade)
  priestId       String
  priest         PriestProfile     @relation("PriestAppointments", fields: [priestId], references: [id], onDelete: Cascade)
  date           DateTime          // The date of confession
  timeSlot       String            // e.g. "18:00 - 18:30"
  status         AppointmentStatus @default(PENDING)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([priestId, date, timeSlot])
}

model FamilyHead {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String            // 3 parts
  nationalId       String            @unique
  street           String
  buildingNumber   String
  floor            String
  apartment        String
  job              String
  phoneNumbers     String            // comma-separated list
  email            String?
  socialStatus     SocialStatus      @default(SINGLE)

  // Wife Details (if married)
  wifeName             String?
  wifeNationalId       String?
  wifeJob              String?
  wifePhone            String?
  wifeEmail            String?
  wifeConfessionFather String?

  // Dynamic Lists stored as JSON for flexibility:
  // children: Array of { nationalId: String, name: String, educationOrJob: String, phone?: String }
  childrenJson     String            @default("[]")
  // relatives: Array of { name: String, nationalId: String, relationshipType: String }
  relativesJson    String            @default("[]")
  // servants: Array of Strings (Name only)
  servantsJson     String            @default("[]")

  notes            String?
  status           MembershipStatus  @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model MassSchedule {
  id          String   @id @default(uuid())
  dayAr       String   // e.g., "الأحد"
  dayEn       String   // e.g., "Sunday"
  timeAr      String   // e.g., "7:00 ص - 9:00 ص"
  timeEn      String   // e.g., "7:00 AM - 9:00 AM"
  eventTypeAr String   // e.g., "القداس الأول"
  eventTypeEn String   // e.g., "First Liturgy"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sermon {
  id           String   @id @default(uuid())
  titleAr      String
  titleEn      String
  priestNameAr String
  priestNameEn String
  topicAr      String
  topicEn      String
  date         DateTime
  youtubeUrl   String   // Direct embed URL or youtube ID
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id                    String             @id @default(uuid())
  titleAr               String
  titleEn               String
  descriptionAr         String
  descriptionEn         String
  type                  String             // e.g. "MASS", "CONFERENCE", "TRIP", "PRAYERS", "SPECIAL"
  date                  DateTime
  locationAr            String?
  locationEn            String?
  price                 Float?             // Optional (e.g. for trips)
  imageUrl              String?
  isPublicVisible       Boolean            @default(false)
  isApplicationActive   Boolean            @default(false)
  status                String             @default("DRAFT") // DRAFT, PUBLISHED, OPEN, CLOSED, COMPLETED, CANCELLED
  applicationOpenDate   DateTime?
  applicationCloseDate  DateTime?
  timezone              String             @default("Africa/Cairo")
  startTime             String?
  endTime               String?
  eligibilityRulesJson  String             @default("{}")
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tripBookings          TripBooking[]
  locations             EventLocation[]
  invitations           EventInvitation[]
  applications          EventApplication[]
}

model SystemConfig {
  key   String @id
  value String
}

model News {
  id                  String              @id @default(uuid())
  titleAr             String?
  titleEn             String?
  content             String?             // the text content (can be rich text or plain)
  imageUrl            String?             // optional uploaded image (base64 or link)
  authorId            String
  author              User                @relation("UserNews", fields: [authorId], references: [id], onDelete: Cascade)
  originalFbPermalink String?             // Original Facebook post link if imported
  fbPostImportId      String?             @unique
  fbPostImport        FacebookPostImport? @relation(fields: [fbPostImportId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model ActionLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  userName  String
  action    String
  details   String
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

enum TripPaymentMethod {
  FULL
  INSTALLMENT
}

enum TripPaymentChannel {
  CASH
  INSTAPAY
}

enum TripBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model TripBooking {
  id               String             @id @default(uuid())
  eventId          String
  event            Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fullName         String
  phone            String
  paymentMethod    TripPaymentMethod  @default(FULL)
  firstInstallment Float?             // Only for INSTALLMENT
  totalAmount      Float
  paymentChannel   TripPaymentChannel @default(CASH)
  receiptImageUrl  String?            // InstaPay receipt screenshot (base64)
  status           TripBookingStatus  @default(PENDING)
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model AiKnowledgeItem {
  id                   String   @id @default(uuid())
  titleAr              String
  titleEn              String
  contentAr            String
  contentEn            String
  category             String   @default("GENERAL") // SCHEDULE, CLERGY, POLICY, FAQ, EVENT, GENERAL
  status               String   @default("APPROVED") // DRAFT, REVIEW, APPROVED, PUBLISHED, ARCHIVED
  sourceType           String   @default("ADMIN_CHAT") // ADMIN_CHAT, MANUAL, IMPORTED, DOCUMENT
  sourceConversationId String?
  sourceMessageId      String?
  version              Int      @default(1)
  createdById          String?
  updatedById          String?
  lastVerifiedAt       DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model AiAdminConversation {
  id         String           @id @default(uuid())
  title      String
  creatorId  String
  creator    User             @relation("UserAdminAiConversations", fields: [creatorId], references: [id], onDelete: Cascade)
  status     String           @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  messages   AiAdminMessage[]

  @@index([creatorId])
  @@index([status])
}

model AiAdminMessage {
  id                   String              @id @default(uuid())
  conversationId       String
  conversation         AiAdminConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId             String?
  senderType           String              // 'ADMIN' or 'AI'
  content              String
  language             String              @default("ar")
  provider             String?
  model                String?
  tokensUsed           Int                 @default(0)
  extractedKnowledgeId String?
  createdAt            DateTime            @default(now())

  @@index([conversationId])
}

model AiSupportRequest {
  id            String   @id @default(uuid())
  referenceCode String   @unique
  userId        String?
  name          String
  phone         String
  email         String?
  category      String   @default("GENERAL") // PASTORAL, GENERAL, CONFESSION_BOOKING, TECHNICAL
  message       String
  status        String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED, CANCELLED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([referenceCode])
}

model AiEvaluationCase {
  id                String    @id @default(uuid())
  title             String
  category          String    // SCHEDULE, CLERGY, EVENTS, SACRAMENT, SECURITY, BILINGUAL, GENERAL
  promptAr          String
  promptEn          String
  expectedKeywords  String    // JSON string array
  forbiddenKeywords String?   // JSON string array
  targetAction      String?
  lastRunAt         DateTime?
  lastPassed        Boolean?
  lastScore         Float?
  lastLatencyMs     Int?
  lastProvider      String?
  lastActualOutput  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category])
}

// ==========================================
// SYSTEM 1: FACEBOOK & NEWS MODERATION
// ==========================================

model FacebookPostImport {
  id               String    @id @default(uuid())
  externalPostId   String    @unique
  permalink        String
  authorName       String    @default("كنيسة الشهيد أبي سيفين")
  postText         String?
  mediaUrlsJson    String    @default("[]") // Array of { url: string, type: 'image' | 'video', sizeBytes?: number }
  totalMediaSize   Int       @default(0)
  publishedAt      DateTime  @default(now())
  status           String    @default("PENDING") // PENDING, PUBLISHED, ARCHIVED, FAILED
  importType       String    @default("MANUAL")  // AUTOMATIC, MANUAL
  errorMessage     String?
  publishedNews    News?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([externalPostId])
}

// ==========================================
// SYSTEM 2: ADMIN EMAIL CENTER
// ==========================================

model EmailConversation {
  id             String         @id @default(uuid())
  subject        String
  threadId       String?        @unique
  status         String         @default("ACTIVE") // ACTIVE, ARCHIVED, SPAM
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  messages       EmailMessage[]

  @@index([status])
  @@index([lastMessageAt])
}

model EmailMessage {
  id               String            @id @default(uuid())
  conversationId   String
  conversation     EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderEmail      String
  senderName       String?
  recipientEmail   String
  recipientName    String?
  recipientUserId  String?
  recipientUser    User?             @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  direction        String            // OUTBOUND, INBOUND
  subject          String
  bodyHtml         String
  bodyText         String
  messageIdHeader  String?           @unique
  inReplyToHeader  String?
  status           String            @default("QUEUED") // QUEUED, SENT, DELIVERED, BOUNCED, FAILED, RECEIVED
  failureReason    String?
  attachmentsJson  String            @default("[]")
  createdAt        DateTime          @default(now())

  @@index([conversationId])
  @@index([recipientEmail])
  @@index([status])
}

// ==========================================
// SYSTEM 3: EVENTS, INVITATIONS, VIP & QR
// ==========================================

model EventLocation {
  id              String                     @id @default(uuid())
  eventId         String
  event           Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  nameAr          String
  nameEn          String
  addressAr       String?
  addressEn       String?
  maxCapacity     Int
  confirmedCount  Int                        @default(0)
  isFull          Boolean                    @default(false)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  invitations     EventInvitation[]
  applications    EventApplication[]
  capacityLogs    EventLocationCapacityLog[]

  @@index([eventId])
}

model EventLocationCapacityLog {
  id          String        @id @default(uuid())
  locationId  String
  location    EventLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  oldCapacity Int
  newCapacity Int
  changedById String
  reason      String
  createdAt   DateTime      @default(now())

  @@index([locationId])
}

model EventApplication {
  id            String         @id @default(uuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locationId    String
  location      EventLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  externalEmail String?
  fullName      String
  phone         String
  status        String         @default("PENDING") // PENDING, APPROVED, REJECTED, CONFIRMED
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([eventId])
  @@index([locationId])
  @@index([status])
}

model EventInvitation {
  id                  String             @id @default(uuid())
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  locationId          String
  location            EventLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientEmail      String
  recipientName       String
  type                String             @default("STANDARD") // STANDARD, VIP
  qrToken             String             @unique
  status              String             @default("ACTIVE")   // ACTIVE, REDEEMED, CANCELLED, REVOKED, EXPIRED
  redeemedAt          DateTime?
  redeemedById        String?
  emailDeliveryStatus String             @default("QUEUED")   // QUEUED, SENT, DELIVERED, FAILED
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  checkInLogs         EventCheckInLog[]

  @@index([eventId])
  @@index([locationId])
  @@index([userId])
  @@index([qrToken])
  @@index([status])
  @@index([type])
}

model EventCheckInLog {
  id             String          @id @default(uuid())
  invitationId   String
  invitation     EventInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  scannedById    String
  status         String          @default("VERIFIED") // VERIFIED, REVERSED
  reversalReason String?
  reversedById   String?
  createdAt      DateTime        @default(now())

  @@index([invitationId])
}

// ==========================================
// SYSTEM 4: FY — FAITH & QUESTIONS & BIBLE
// ==========================================

model BibleTranslation {
  id            String         @id
  nameAr        String
  nameEn        String
  language      String         // "ar" or "en"
  isPublicDomain Boolean       @default(true)
  licenseInfo   String?
  chapters      BibleChapter[]
}

model BibleBook {
  id           String         @id // e.g. "GEN", "MAT"
  testament    String         // "OLD" or "NEW"
  orderIndex   Int
  nameAr       String
  nameEn       String
  chapterCount Int
  chapters     BibleChapter[]

  @@index([testament])
  @@index([orderIndex])
}

model BibleChapter {
  id            String           @id @default(uuid())
  translationId String
  translation   BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)
  bookId        String
  book          BibleBook        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterNumber Int
  versesJson    String           // JSON array of { verseNumber: number, text: string }
  verseCount    Int
  createdAt     DateTime         @default(now())

  @@unique([translationId, bookId, chapterNumber])
  @@index([translationId, bookId])
}

model BibleReadingProgress {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId String
  bookId        String
  chapterNumber Int
  isCompleted   Boolean  @default(true)
  completedAt   DateTime @default(now())

  @@unique([userId, translationId, bookId, chapterNumber])
  @@index([userId])
}

model BibleLastPosition {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId String
  bookId        String
  chapterNumber Int
  verseNumber   Int?
  updatedAt     DateTime @updatedAt
}

model BibleVerseOfDay {
  id                    String   @id @default(uuid())
  date                  String   @unique // YYYY-MM-DD
  translationId         String   @default("van-dyck")
  bookId                String
  chapterNumber         Int
  verseNumber           Int
  verseTextAr           String
  verseTextEn           String
  referenceAr           String
  referenceEn           String
  devotionalTextAr      String?
  devotionalTextEn      String?
  reflectionQuestionAr  String?
  reflectionQuestionEn  String?
  isPublished           Boolean  @default(true)
  isManual              Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([date])
}

model BibleFavorite {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  translationId String   @default("van-dyck")
  bookSlug      String
  chapterNumber Int
  verseNumber   Int
  verseText     String
  reference     String
  note          String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([bookSlug, chapterNumber])
}

model BibleJournalEntry {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  content         String
  reflectionDate  DateTime @default(now())
  passagesJson    String   @default("[]")
  tagsJson        String   @default("[]")
  promptQuestion  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([reflectionDate])
}

model BibleReadingPlan {
  id            String                    @id @default(uuid())
  slug          String                    @unique
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  estimatedDays Int                       @default(30)
  isPublished   Boolean                   @default(true)
  orderIndex    Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  sessions      BibleReadingPlanSession[]
  userProgress  BibleUserPlanProgress[]
}

model BibleReadingPlanSession {
  id                    String           @id @default(uuid())
  planId                String
  plan                  BibleReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber             Int
  titleAr               String
  titleEn               String
  referencesJson        String           @default("[]")
  reflectionQuestionAr  String?
  reflectionQuestionEn  String?

  @@unique([planId, dayNumber])
  @@index([planId])
}

model BibleUserPlanProgress {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              BibleReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status            String           @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED
  completedDaysJson String           @default("[]")
  startedAt         DateTime         @default(now())
  lastReadAt        DateTime         @default(now())
  completedAt       DateTime?

  @@unique([userId, planId])
  @@index([userId])
}

model BibleTopic {
  id               String   @id @default(uuid())
  slug             String   @unique
  nameAr           String
  nameEn           String
  descriptionAr    String
  descriptionEn    String
  category         String   @default("life")
  passagesJson     String   @default("[]")
  relatedSlugsJson String   @default("[]")
  orderIndex       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BibleTimelineEvent {
  id             String   @id @default(uuid())
  slug           String   @unique
  period         String
  periodNameAr   String
  periodNameEn   String
  titleAr        String
  titleEn        String
  descriptionAr  String
  descriptionEn  String
  orderIndex     Int      @default(0)
  referencesJson String   @default("[]")
  peopleJson     String   @default("[]")
  placesJson     String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([period])
}

model BiblePerson {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  aliasesAr      String?
  aliasesEn      String?
  roleAr         String
  roleEn         String
  bioAr          String
  bioEn          String
  referencesJson String   @default("[]")
  relationsJson  String   @default("[]")
  eventsJson     String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BiblePlace {
  id             String   @id @default(uuid())
  slug           String   @unique
  nameAr         String
  nameEn         String
  descriptionAr  String
  descriptionEn  String
  regionAr       String?
  regionEn       String?
  referencesJson String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BibleBackgroundConfig {
  id                      String   @id @default("default")
  darkAssetPath           String   @default("/images/bible/bible-bg-dark.png")
  lightAssetPath          String   @default("/images/bible/bible-bg-light.png")
  darkTextColor           String   @default("#ffffff")
  lightTextColor          String   @default("#18191c")
  darkOverlayOpacity      Float    @default(0.15)
  lightOverlayOpacity     Float    @default(0.05)
  horizontalMarginPercent Float    @default(9.0)
  verticalMarginPercent   Float    @default(11.0)
  defaultFontFamily       String   @default("Amiri")
  updatedAt               DateTime @updatedAt
}

model FyQuestionCategory {
  id         String       @id @default(uuid())
  slug       String       @unique
  nameAr     String
  nameEn     String
  orderIndex Int          @default(0)
  questions  FyQuestion[]

  @@index([slug])
}

model FyQuestion {
  id                String              @id @default(uuid())
  categoryId        String?
  category          FyQuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  titleAr           String
  titleEn           String?
  slug              String              @unique
  answerTextAr      String?
  answerTextEn      String?
  videoUrl          String?
  externalLinksJson String              @default("[]") // Array of { titleAr, titleEn, url }
  tags              String              @default("[]") // JSON string array
  status            String              @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isFeatured        Boolean             @default(false)
  authorId          String?
  publishedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([slug])
}

model FyMemberQuestionSubmission {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAnonymous         Boolean  @default(false)
  authorDisplayName   String?
  questionTitle       String
  questionDetails     String
  categorySlug        String?
  status              String   @default("PENDING_REVIEW") // PENDING_REVIEW, UNDER_REVIEW, ANSWER_DRAFTED, PUBLISHED, REJECTED, ARCHIVED
  moderatorNotes      String?
  publishedQuestionId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ==========================================
// 8. OUR HISTORY & HISTORICAL CLERGY ARCHIVE
// ==========================================

model HistorySettings {
  id              String   @id @default("default-history-settings")
  foundingYear    Int      @default(1955)
  headlineAr      String   @default("لكل كنيسة حكاية... وهذه حكايتنا.")
  headlineEn      String   @default("Every church has a story. This is ours.")
  subheadlineAr   String   @default("منذ عام 1955")
  subheadlineEn   String   @default("Since 1955")
  introTextAr     String   @default("تاريخ كنيسة الشهيد العظيم أبي سيفين هو رحلة مباركة من الإيمان والخدمة والرعاية الروحية تمتد عبر أجيال من الآباء الأجلاء والشمامسة والخدام وشعب الكنيسة المبارك.")
  introTextEn     String   @default("The history of St. Philopater Church is a blessed journey of faith, service, and pastoral care spanning generations of revered clergy, servants, and congregation.")
  heroImageUrl    String?
  updatedAt       DateTime @updatedAt
}

model HistoryChapter {
  id              String   @id @default(uuid())
  slug            String   @unique
  titleAr         String
  titleEn         String
  shortIntroAr    String?
  shortIntroEn    String?
  narrativeAr     String
  narrativeEn     String?
  heroImageUrl    String?
  orderIndex      Int      @default(0)
  status          String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  quoteText       String?
  quoteSource     String?
  documentsJson   String   @default("[]") // [{ titleAr, titleEn, url, type, size }]
  galleryJson     String   @default("[]") // [{ url, captionAr, captionEn, credit }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
  @@index([orderIndex])
  @@index([status])
}

model HistoryClergyRecord {
  id                   String   @id @default(uuid())
  ecclesiasticalNameAr String
  ecclesiasticalNameEn String?
  secularName          String?
  isSecularNameVisible Boolean  @default(true)
  avatarUrl            String?
  serviceStartDate     String   // YYYY-MM-DD or YYYY
  serviceEndDate       String?  // null if unknown or ongoing
  datePrecision        String   @default("EXACT") // EXACT, YEAR_ONLY, APPROXIMATE
  isOngoing            Boolean  @default(false)
  isDeceased           Boolean  @default(false)
  isServingAbroad      Boolean  @default(false)
  servingAbroadLocation String?
  clergyRole           String   @default("PRIEST") // PRIEST, BISHOP, MONK_PRIEST, ARCHPRIEST
  titleAr              String?  // e.g. القمص, القس, الراهب القمص
  titleEn              String?
  bioAr                String?
  bioEn                String?
  orderIndex           Int      @default(0)
  verificationStatus   String   @default("VERIFIED") // DRAFT, AWAITING_VERIFICATION, VERIFIED
  verificationWarning  String?  // Administrative warning note
  archivalNotes        String?
  status               String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  relatedEventsJson    String   @default("[]")
  documentsJson        String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orderIndex])
  @@index([status])
  @@index([verificationStatus])
}

model HistoryEvent {
  id                  String   @id @default(uuid())
  titleAr             String
  titleEn             String?
  descriptionAr       String
  descriptionEn       String?
  eventDate           String   // YYYY-MM-DD or YYYY
  year                Int
  datePrecision       String   @default("YEAR_ONLY") // EXACT, YEAR_ONLY, APPROXIMATE, UNDATED
  category            String   @default("FOUNDATION") // FOUNDATION, CONSTRUCTION, EXPANSION, CLERGY_APPOINTMENT, CELEBRATION, ANNIVERSARY, PAPAL_VISIT, EPISCOPAL_VISIT, MINISTRY, COMMUNITY
  mainImageUrl        String?
  galleryJson         String   @default("[]")
  relatedClergyIds    String   @default("[]")
  relatedChapterSlug  String?
  sources             String?
  verificationStatus  String   @default("VERIFIED") // DRAFT, AWAITING_VERIFICATION, VERIFIED
  status              String   @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  orderIndex          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([year])
  @@index([category])
  @@index([status])
}

model HistoryVisit {
  id                    String   @id @default(uuid())
  visitorNameAr         String
  visitorNameEn         String?
  ecclesiasticalTitleAr String
  ecclesiasticalTitleEn String?
  visitTitleAr          String
  visitTitleEn          String?
  visitDate             String   // YYYY-MM-DD or YYYY
  year                  Int
  locationAr            String?
  locationEn            String?
  occasionAr            String?
  occasionEn            String?
  narrativeAr           String
  narrativeEn           String?
  mainImageUrl          String?
  galleryJson           String   @default("[]")
  documentsJson         String   @default("[]")
  relatedClergyIds      String   @default("[]")
  verificationStatus    String   @default("VERIFIED")
  status                String   @default("PUBLISHED")
  orderIndex            Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([year])
  @@index([status])
}

model HistoryMediaItem {
  id                   String   @id @default(uuid())
  url                  String
  titleAr              String
  titleEn              String?
  captionAr            String?
  captionEn            String?
  mediaType            String   @default("IMAGE") // IMAGE, DOCUMENT, VIDEO
  year                 Int?
  approximateDate      String?
  category             String   @default("CHURCH_BUILDING") // CHURCH_BUILDING, CLERGY, VISIT, CELEBRATION, DOCUMENT, CEREMONY
  photographerOrSource String?
  archivalCredit       String?
  altText              String?
  isPublic             Boolean  @default(true)
  galleryJson          String?  @default("[]") // For group images / albums under one title
  status               String   @default("PUBLISHED")
  orderIndex           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([mediaType])
}

model HistoryPopeRecord {
  id           String   @id @default(uuid())
  nameAr       String
  nameEn       String?
  titleAr      String   @default("قداسة البابا المعظم")
  titleEn      String?  @default("H.H. Pope")
  papalNumber  Int?     // 116, 117, 118
  papacyPeriod String   // e.g. "1959 - 1971"
  isDeceased   Boolean  @default(true)
  avatarUrl    String?
  bioAr        String?
  bioEn        String?
  orderIndex   Int      @default(0)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderIndex])
  @@index([status])
}

model HistoryBishopRecord {
  id              String   @id @default(uuid())
  nameAr          String
  nameEn          String?
  titleAr         String   @default("الأسقف العام")
  titleEn         String?  @default("General Bishop")
  episcopalPeriod String   // e.g. "2013 - حتى الآن"
  isDeceased      Boolean  @default(false)
  avatarUrl       String?
  bioAr           String?
  bioEn           String?
  orderIndex      Int      @default(0)
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderIndex])
  @@index([status])
}

model HistoryServantCategory {
  id         String   @id @default(uuid())
  key        String   @unique // e.g. "DEACON", "PRIEST_MONK", "CONSECRATED"
  nameAr     String
  nameEn     String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orderIndex])
}

model HistoryServantFruit {
  id                      String   @id @default(uuid())
  fullNameAr              String
  fullNameEn              String?
  currentRole             String   // e.g. "شماس دياكون", "كاهن مبارك", "راهب", "خادم مكرس"
  categoryKey             String?  @default("DEACON")
  ordinationYear          String?
  currentChurchOrLocation String?  // e.g. "دير الشهيد مارمينا", "كنيسة العذراء"
  avatarUrl               String?
  notes                   String?
  orderIndex              Int      @default(0)
  status                  String   @default("PUBLISHED")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([orderIndex])
  @@index([status])
  @@index([categoryKey])
}



